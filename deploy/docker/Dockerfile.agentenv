# syntax=docker/dockerfile:1.7

ARG AENV_VIRTUALIZATION_MODE=kvm
ARG AENV_GIT_COMMIT=development

FROM rust:1-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS chef

WORKDIR /build
ENV CARGO_TARGET_DIR=/build/target
ENV RUSTUP_TOOLCHAIN=${RUST_VERSION}
ARG APT_MIRROR_BASE
COPY deploy/docker/apply_apt_mirror.sh /usr/local/bin/apply_apt_mirror.sh

# envd build scripts require protoc during Rust compilation.
RUN sh /usr/local/bin/apply_apt_mirror.sh "${APT_MIRROR_BASE}" \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        clang \
        libclang-dev \
        libprotobuf-dev \
        protobuf-compiler \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo install cargo-chef --locked

FROM chef AS planner

COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS build-deps

COPY --from=planner /build/recipe.json recipe.json
# Keep Cargo target artifacts in this image layer rather than a BuildKit cache
# mount. Cache mounts are local to a builder and are not included in exported
# external caches; persisting target here lets fresh CI runners reuse the
# cargo-chef dependency layer.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --release --recipe-path recipe.json

FROM build-deps AS builder

ARG AENV_GIT_COMMIT
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    test -n "${AENV_GIT_COMMIT}" \
    && AENV_GIT_COMMIT="${AENV_GIT_COMMIT}" cargo build --release -p agentenv --bin server -p uvm-ublk-daemon --bin uvm-ublk-daemon \
    && grep -aFq "${AENV_GIT_COMMIT}" /build/target/release/server \
    && cp /build/target/release/server /out-server \
    && cp /build/target/release/uvm-ublk-daemon /out-uvm-ublk-daemon

FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517 AS runtime-base
ARG APT_MIRROR_BASE
ARG TARGETARCH
# Docker caches the complete apt transaction even after Ubuntu publishes a
# security update. Advance this reviewed epoch when the release scanner finds a
# patched Ubuntu package newer than the cached runtime-base layer.
ARG UBUNTU_APT_SECURITY_EPOCH=2026-08-27
# Optional extra runtime packages, specified as a whitespace- or comma-separated build arg.
ARG EXTRA_RUNTIME_PACKAGES=""
COPY deploy/docker/apply_apt_mirror.sh /usr/local/bin/apply_apt_mirror.sh

# Runtime packages needed by both the deps pre-bake and the final image.
RUN test -n "${UBUNTU_APT_SECURITY_EPOCH}" \
    && export DEBIAN_FRONTEND=noninteractive \
    && sh /usr/local/bin/apply_apt_mirror.sh "${APT_MIRROR_BASE}" \
    && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        amazon-ecr-credential-helper \
        curl \
        e2fsprogs \
        iproute2 \
        iptables \
        jq \
        sudo \
        umoci \
        zstd \
    && if [ -n "${EXTRA_RUNTIME_PACKAGES}" ]; then \
        printf '%s\n' "${EXTRA_RUNTIME_PACKAGES}" \
            | tr ' ,' '\n' \
            | sed '/^$/d' \
            | xargs -r apt-get install -y --no-install-recommends --; \
    fi \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN mkdir -p /workspace/config


# deps-stage: best-effort deps pre-bake. Runs `--setup-only` against a freshly
# built server purely to materialize the runtime deps tree (firecracker,
# kernel, tools.ext4, overlaybd CLI) and regctl into `/opt/agentenv/deps` and
# `/usr/local/bin/regctl`. The final stage copies that tree as its own clean
# layer, keeping the deps payload independent of the server binary.
FROM runtime-base AS deps-stage
ARG AENV_VIRTUALIZATION_MODE
COPY --from=builder --chmod=0755 /out-server /server
COPY config/default.toml /workspace/config/default.toml
ENV AENV_CONFIG_PATH=/workspace/config/default.toml
ENV AENV_HOME_PATH=/workspace/env
ENV AENV_DEPS_PATH=/opt/agentenv/deps
ENV AENV_VIRTUALIZATION_MODE=${AENV_VIRTUALIZATION_MODE}
RUN DEBIAN_FRONTEND=noninteractive /server --setup-only


# final image.
FROM runtime-base
ARG AENV_VIRTUALIZATION_MODE

# overlaybd-apply validates its built-in default service config path even when
# AgentENV passes an explicit generated config at runtime.
RUN mkdir -p /etc/overlaybd \
    && printf '{}\n' > /etc/overlaybd/overlaybd.json

# Pre-baked runtime deps from `deps-stage`. Paths must match what `--setup-only`
# produces; see src/setup/deps.rs and src/setup/overlaybd.rs.
COPY --from=deps-stage /opt/agentenv/deps /opt/agentenv/deps

# Binaries: ublk-daemon first (less likely to change) so a server-only code
# change does not invalidate its layer. `--chmod=0755` avoids a separate
# `RUN chmod` layer that would duplicate every binary.
COPY --from=builder --chmod=0755 /out-uvm-ublk-daemon /usr/local/bin/uvm-ublk-daemon
COPY --from=builder --chmod=0755 /out-server /server

COPY config/default.toml /workspace/config/default.toml
ENV AENV_CONFIG_PATH=/workspace/config/default.toml
ENV AENV_HOME_PATH=/workspace/env
ENV AENV_DEPS_PATH=/opt/agentenv/deps
ENV AENV_VIRTUALIZATION_MODE=${AENV_VIRTUALIZATION_MODE}
ENV AENV_UBLK_DAEMON_BINARY_PATH=/usr/local/bin/uvm-ublk-daemon

# Authoritative final `--setup-only`. If the pre-bake above produced exactly
# what the server expects this is a fast no-op (every entry hits an
# "already present, skipping" branch). If anything is missing or stale, it
# is downloaded/regenerated here, so the resulting image is always correct
# regardless of whether the pre-bake was perfect.
RUN DEBIAN_FRONTEND=noninteractive /server --setup-only

ENTRYPOINT ["/server"]
